{
  "name": "opencode-sidebar-token-metrics",
  "version": "0.1.4",
  "description": "OpenCode sidebar plugin showing generation speed (tok/s), cache hit rate, and average time-to-first-token (TTFT).",
  "type": "module",
  "exports": {
    "./tui": {
      "types": "./src/tui.tsx",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "sidebar",
    "tokens",
    "ttft",
    "metrics"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youngxhui/opencode-sidebar-token-metrics.git"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@opencode/plugin": "^2.0.13",
    "@opentui/core": "^0.5.12",
    "@opentui/solid": "^0.5.12",
    "babel-preset-solid": "1.9.12",
    "solid-js": "^1.9.12",
    "typescript": "^5.9.3"
  }
}
